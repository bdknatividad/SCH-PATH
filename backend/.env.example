# ── Backend environment template ──────────────────────────────────────────
# Copy to `.env` for local development. On Render, set these in the service's
# Environment tab instead — do NOT commit a .env.

# Many hosts (Render, Railway, Fly) assign the port at runtime. Leave this
# unset in production so the host's PORT is used; 5000 is the local default.
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────
# MySQL / MariaDB. Local development uses XAMPP; production uses a managed
# MySQL instance (Railway, Aiven, Clever Cloud). The application uses MySQL-
# specific SQL throughout, so the server must be MySQL-compatible.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sch_path_db

# Managed MySQL providers require TLS. Set to true in production; leave false
# for a local XAMPP/XAMPP-style server that has no certificate.
DB_SSL=false

# ── Connection pool ───────────────────────────────────────────────────────
# How many requests may touch the database at the same time. Past this, callers
# wait in an unbounded queue, so a pool that is too small shows up as slowness
# rather than as an error.
#
# Leave this BELOW the provider's own connection cap. Managed plans commonly
# allow a few dozen connections, and exceeding the cap refuses the client with
# "Too many connections" — a hard failure for everyone at once. Half the plan's
# allowance is a safe choice; the extra headroom covers migrations, the three
# cron jobs and any admin session.
#
# Default 20. Maximum accepted 200.
DB_POOL_LIMIT=20

# ── Authentication ────────────────────────────────────────────────────────
# MUST be replaced. The server refuses to start if this is missing, shorter
# than 16 characters, or still looks like a placeholder.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_any_random_secret_string
JWT_EXPIRE=24h

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated allow-list of the browser origins permitted to call this API.
# Needed only in a split deployment (frontend on Vercel, backend elsewhere).
#
#   Vercel frontend → https://<your-project>.vercel.app
#   Custom domain   → https://your-domain.com,https://www.your-domain.com
#
# Leave EMPTY when the backend serves the built frontend from the same origin:
# there is no cross-origin request to authorise, and an empty value keeps the
# permissive default that local development relies on.
CORS_ORIGIN=
