          "delete",
          "export"
        ],
        "Documents": [
          "view",
          "create",
          "edit",
          "export"
        ]
      }
    },
    "educator": {
      "label": "Educator",
      "fullAccess": false,
      "description": "Education records and school-related documentation for residents. Holds Dashboard, Child Records (Personal Info and the Education tab, read-only), the Education module and Documents. The dashboard is education-only. Never reaches Medical records, the Health module, Violations, Incidents, Admissions or any administrative module, and holds no document create, delete or global approval: a document outside the Education categories is readable only through an approved document access request.",
      "modules": [
        "Dashboard",
        "Child Records",
        "Education",
        "Documents"
      ],
      "subModules": {
        "Child Records": [
          "Personal Info",
          "Education"
