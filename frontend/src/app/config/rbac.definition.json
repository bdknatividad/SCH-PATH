    "nurse": {
      "label": "Nurse",
      "fullAccess": false,
      "description": "Health and medical records. Holds Dashboard, Child Records (Personal Info / Phase Timeline / Medical), Health and Documents. Creates and manages medical records and medical documents — including the Medical Notes on the Medical tab — and every medical document is filed in the Documents module's Medical Records folder. Reads incident forms but never creates, edits or deletes one. Holds no document delete and no global document approval: a document request is decided only by a role that holds the Documents approve capability. The Behavioral tab and the Violations module are not held by default; they may be granted per account, which is the \"can view if authorized\" case.",
      "modules": [
        "Dashboard",
        "Child Records",
        "Health",
        "Documents"
      ],
      "subModules": {
        "Child Records": [
          "Personal Info",
          "Phase Timeline",
