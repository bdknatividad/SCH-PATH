    "centerhead": {
      "label": "Center Head",
      "fullAccess": true,
      "description": "Full System Access. Unrestricted access to every route, API, record and action. Bypasses all permission checks.",
      "modules": "*",
      "subModules": "*",
      "permissions": "*"
    },
    "admin": {
      "label": "Administrator",
      "fullAccess": false,
      "description": "Holds every module and every permission, but is not a bypass: routes that are deliberately restricted to the Center Head (account management, phase transitions) stay Center Head-only.",
      "modules": "*",
      "subModules": "*",
      "permissions": "*"
    },
    "socialworker": {
      "label": "Social Worker",
      "fullAccess": false,
      "description": "Case management across residents, violations, interventions, court records, houseparent oversight and reports. No access to Health, Education (main module) or Account Management.",
