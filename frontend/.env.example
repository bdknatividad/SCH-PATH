# ── Frontend environment template ─────────────────────────────────────────
# Copy to `.env` for local development. On Vercel, set these in
# Project → Settings → Environment Variables instead — do NOT commit a .env.
#
# Vite inlines VITE_* values at BUILD time, so a change here only takes effect
# after a rebuild. On Vercel, changing an env var requires a redeploy.

# Where the backend API lives.
#
#   Local development            → http://localhost:5000/api
#   Vercel + backend on Render   → https://<your-service>.onrender.com/api
#   Backend serving the frontend → leave unset (falls back to same-origin /api)
#
# Must include the /api suffix. A trailing slash is tolerated and trimmed.
VITE_API_URL=http://localhost:5000/api
